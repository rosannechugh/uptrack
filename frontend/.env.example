# Base URL the browser uses to reach the UpTrack API.
# Keep the default "/api": the Vite dev/preview server proxies it to FastAPI,
# which sidesteps CORS (the backend ships without CORS middleware).
# An absolute URL such as http://localhost:8000 only works if CORS is enabled
# on the backend.
VITE_API_BASE_URL=/api

# Where the Vite dev/preview server proxies /api to (the FastAPI server).
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000
